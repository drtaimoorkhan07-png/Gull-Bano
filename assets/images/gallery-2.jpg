<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1000" width="800" height="1000">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFF3E0"/>
      <stop offset="50%" stop-color="#FFF8F0"/>
      <stop offset="100%" stop-color="#F8C8DC"/>
    </linearGradient>
    <linearGradient id="flowerGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#D4AF37"/>
      <stop offset="100%" stop-color="#E75480"/>
    </linearGradient>
    <radialGradient id="goldGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#D4AF37" stop-opacity="0.5"/>
      <stop offset="100%" stop-color="#D4AF37" stop-opacity="0"/>
    </radialGradient>
    <filter id="softGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="8" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Background -->
  <rect width="100%" height="100%" fill="url(#bg)" rx="32"/>

  <!-- Ornate Decorative Floral Border -->
  <rect x="24" y="24" width="752" height="952" rx="24" fill="none" stroke="#D4AF37" stroke-width="2" stroke-opacity="0.4" stroke-dasharray="8 6"/>
  <rect x="36" y="36" width="728" height="928" rx="20" fill="none" stroke="#A8325E" stroke-width="1.5" stroke-opacity="0.25"/>

  <!-- Corner Floral Flourishes -->
  <g fill="none" stroke="#D4AF37" stroke-width="2" stroke-linecap="round">
    <!-- Top Left -->
    <path d="M 50 100 Q 50 50 100 50" />
    <path d="M 60 90 Q 60 60 90 60" />
    <circle cx="50" cy="100" r="4" fill="#E75480" />
    <circle cx="100" cy="50" r="4" fill="#E75480" />

    <!-- Top Right -->
    <path d="M 750 100 Q 750 50 700 50" />
    <path d="M 740 90 Q 740 60 710 60" />
    <circle cx="750" cy="100" r="4" fill="#E75480" />
    <circle cx="700" cy="50" r="4" fill="#E75480" />

    <!-- Bottom Left -->
    <path d="M 50 900 Q 50 950 100 950" />
    <circle cx="50" cy="900" r="4" fill="#E75480" />
    <circle cx="100" cy="950" r="4" fill="#E75480" />

    <!-- Bottom Right -->
    <path d="M 750 900 Q 750 950 700 950" />
    <circle cx="750" cy="900" r="4" fill="#E75480" />
    <circle cx="700" cy="950" r="4" fill="#E75480" />
  </g>

  <!-- Glowing Backdrop Circle -->
  <circle cx="400" cy="450" r="220" fill="url(#goldGlow)" />
  <circle cx="400" cy="450" r="180" fill="#FFFFFF" fill-opacity="0.65" stroke="#E75480" stroke-width="2" stroke-opacity="0.3"/>

  <!-- Blooming Flower Art -->
  <g transform="translate(400, 450) scale(1.4)" filter="url(#softGlow)">
    <!-- Leaves -->
    <path d="M 0 0 C -40 20 -70 80 -40 110 C -10 140 10 70 0 0 Z" fill="#A3B18A" fill-opacity="0.8"/>
    <path d="M 0 0 C 40 20 70 80 40 110 C 10 140 -10 70 0 0 Z" fill="#8FA876" fill-opacity="0.8"/>

    <!-- Petals Outer Layer -->
    <g fill="url(#flowerGrad)" opacity="0.9">
      <path d="M 0 0 C -60 -40 -80 -100 0 -130 C 80 -100 60 -40 0 0 Z" />
      <path d="M 0 0 C -110 -10 -130 -70 -70 -110 C -20 -70 -30 -20 0 0 Z" transform="rotate(60)" />
      <path d="M 0 0 C -110 -10 -130 -70 -70 -110 C -20 -70 -30 -20 0 0 Z" transform="rotate(120)" />
      <path d="M 0 0 C -110 -10 -130 -70 -70 -110 C -20 -70 -30 -20 0 0 Z" transform="rotate(180)" />
      <path d="M 0 0 C -110 -10 -130 -70 -70 -110 C -20 -70 -30 -20 0 0 Z" transform="rotate(240)" />
      <path d="M 0 0 C -110 -10 -130 -70 -70 -110 C -20 -70 -30 -20 0 0 Z" transform="rotate(300)" />
    </g>

    <!-- Petals Inner Layer -->
    <g fill="#FFF" fill-opacity="0.3" transform="scale(0.7) rotate(30)">
      <path d="M 0 0 C -60 -40 -80 -100 0 -130 C 80 -100 60 -40 0 0 Z" fill="#D4AF37"/>
      <path d="M 0 0 C -60 -40 -80 -100 0 -130 C 80 -100 60 -40 0 0 Z" fill="#E75480" transform="rotate(72)"/>
      <path d="M 0 0 C -60 -40 -80 -100 0 -130 C 80 -100 60 -40 0 0 Z" fill="#D4AF37" transform="rotate(144)"/>
      <path d="M 0 0 C -60 -40 -80 -100 0 -130 C 80 -100 60 -40 0 0 Z" fill="#E75480" transform="rotate(216)"/>
      <path d="M 0 0 C -60 -40 -80 -100 0 -130 C 80 -100 60 -40 0 0 Z" fill="#D4AF37" transform="rotate(288)"/>
    </g>

    <!-- Center Golden Pistil -->
    <circle cx="0" cy="0" r="24" fill="#D4AF37"/>
    <circle cx="0" cy="0" r="16" fill="#F7E7B4"/>
    <circle cx="0" cy="0" r="8" fill="#FFF8F0"/>
  </g>

  <!-- Typography -->
  <text x="400" y="740" text-anchor="middle" font-family="'Playfair Display', Georgia, serif" font-size="34" font-weight="700" fill="#3D1F2E" letter-spacing="1">
    Golden Sunset Walk
  </text>
  <text x="400" y="785" text-anchor="middle" font-family="'Poppins', sans-serif" font-size="18" font-weight="400" fill="#A8325E" letter-spacing="2">
    HAND IN HAND FOREVER
  </text>
  <text x="400" y="830" text-anchor="middle" font-family="'Dancing Script', cursive" font-size="24" fill="#D4AF37">
    ~ A Flower in Bloom ~
  </text>
  <text x="400" y="910" text-anchor="middle" font-family="'Poppins', sans-serif" font-size="14" fill="#888" font-style="italic">
    [ Replace with your photo in assets/images/ ]
  </text>
</svg>